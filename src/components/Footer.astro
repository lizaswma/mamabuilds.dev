---
const year = new Date().getFullYear();

const socials = [
  { label: 'Updates', href: '/updates' },
  { label: 'Email', href: 'mailto:liza@mamabuilds.dev' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/lizama/', external: true },
];
---

<footer class="border-t border-sand/80 bg-paper">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-display text-lg font-semibold text-ink">mamabuilds.dev</p>
        <p class="mt-1 max-w-sm text-sm text-ink-soft">
          Built with AI, coffee, and whatever nap time allows.
        </p>
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-ink-soft">
        {socials.map((s) => (
          <a
            href={s.href}
            class="transition-colors hover:text-terracotta"
            {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <p class="mt-8 text-xs text-ink-soft/80">
      &copy; {year} MamaBuilds. All opinions are my own (and occasionally my toddler's).
    </p>
  </div>
</footer>
