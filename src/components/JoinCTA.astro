---
// A light inline note inviting readers to join the MamaBuilds Google Group,
// where Android builds go out before they hit the Play Store.
const groupUrl = 'https://groups.google.com/g/mamabuilds';
---

<aside class="not-prose mt-12 flex flex-col gap-3 rounded-xl border border-sand bg-paper/60 p-5 text-sm sm:flex-row sm:items-center sm:justify-between">
  <p class="leading-relaxed text-ink-soft">
    <span class="font-semibold text-ink">Early Android access.</span>&nbsp;I
    share Android builds with my Google Group before they reach the Play Store.
  </p>
  <a
    href={groupUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="shrink-0 font-semibold text-terracotta underline-offset-4 hover:text-terracotta-dark hover:underline"
  >
    Join the group &rarr;
  </a>
</aside>
