---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="border-b border-sand py-8 first:pt-0 last:border-none">
  <time datetime={pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wide text-terracotta">
    {formattedDate}
  </time>
  <h2 class="mt-2 font-display text-2xl font-semibold text-ink">
    <a href={`/blog/${post.id}`} class="hover:text-terracotta">{title}</a>
  </h2>
  <p class="mt-3 text-ink-soft leading-relaxed">{description}</p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <a href={`/blog/${post.id}`} class="text-sm font-semibold text-ink hover:text-terracotta">
      Read the post &rarr;
    </a>
    {tags.map((tag) => (
      <span class="rounded-full bg-plum-light px-3 py-1 text-xs font-medium text-plum">#{tag}</span>
    ))}
  </div>
</article>
