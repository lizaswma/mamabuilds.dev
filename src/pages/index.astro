---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Newest additions first (see `added` in the projects schema); fall back to
// title so undated projects still sort sensibly.
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      (b.data.added?.valueOf() ?? 0) - (a.data.added?.valueOf() ?? 0) ||
      a.data.title.localeCompare(b.data.title)
  )
  .slice(0, 2);

const [latestPost] = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="MamaBuilds">
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-20 text-center sm:pt-28">
    <p class="font-semibold uppercase tracking-[0.25em] text-terracotta text-sm">
      mamabuilds.dev
    </p>
    <h1 class="mt-4 text-balance font-display text-4xl font-semibold leading-tight text-ink sm:text-5xl">
      Hi, I'm Liza. I'm a product manager who fell down the AI rabbit hole&nbsp;-
      <span class="text-terracotta">and started building.</span>
    </h1>
    <p class="mt-6 text-balance text-lg leading-relaxed text-ink-soft">
      As a working mom to a young toddler I really struggle to keep up with everything,
      and I was worried I was missing out on this whole generative AI evolution. 
      Then I realized the obvious: I should just build apps for myself!
    </p>
    <p class="mt-6 text-balance text-lg leading-relaxed text-ink-soft">
      This is where I share what I make, and what I learn along the way. You'll find a
      blend of apps for product managers and apps for a young family
      like mine.
    </p>
    <p class="mt-6 text-balance text-lg leading-relaxed text-ink-soft">
      Thanks for joining me on my little AI adventure!
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/projects"
        class="rounded-full bg-terracotta px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-terracotta-dark"
      >
        See what I've built
      </a>
      <a
        href="/blog"
        class="rounded-full border border-ink/15 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-terracotta hover:text-terracotta"
      >
        Read the blog
      </a>
    </div>
  </section>

  <!-- Bio / empowering blurb -->
  <section class="border-y border-sand bg-paper">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-16 sm:grid-cols-[1.2fr_1fr] sm:items-center">
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">
          A working mom, learning in public.
        </h2>
        <div class="mt-4 space-y-4 text-ink-soft leading-relaxed">
          <p>
            I've spent my career as a product manager, where I get to work with some
            of the smartest software engineers & designers to build apps that millions
            and billions of consumers use. What I'd never done was build one of those
            things myself.
          </p>
          <p>
            Then AI tools got good enough that "I have an idea" and "I can ship it" stopped
            being separated by years of learning to code. So between meetings, after bedtime,
            and yes, sometimes during naptime, I started building: small apps that solve
            real problems for me, for other PMs, and for my family. 
          </p>
          <p>
            My niche - I've spent a lot of time figuring out how to build apps to further 
            my daughter's language skills since we are trying to get her to learn both
            Cantonese & Mandarin, which 
            is particularly hard when each parent can only speak one and not the other.
          </p>
          <p>
            If you're a mom, a PM, or just someone who's curious but intimidated - I hope
            this site is proof that you can start today, with the time you actually have.
          </p>
        </div>
      </div>

      <div class="rounded-2xl bg-terracotta-light p-8">
        <p class="font-display text-lg font-semibold text-terracotta-dark">What you'll find here</p>
        <ul class="mt-4 space-y-3 text-sm text-ink">
          <li class="flex gap-2">
            <span aria-hidden="true">🧩</span>
            <span>Small, real apps I've built with AI - with plain instructions on how to try them.</span>
          </li>
          <li class="flex gap-2">
            <span aria-hidden="true">✍️</span>
            <span>Honest write-ups on what worked, what broke, and what I'd do differently.</span>
          </li>
          <li class="flex gap-2">
            <span aria-hidden="true">🍼</span>
            <span>A PM's-eye view of building for busy families, starting with my own.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">Latest projects</h2>
      <a href="/projects" class="text-sm font-semibold text-terracotta hover:text-terracotta-dark">
        View all &rarr;
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Latest post -->
  {latestPost && (
    <section class="border-t border-sand bg-paper">
      <div class="mx-auto max-w-5xl px-6 py-16">
        <div class="flex items-end justify-between">
          <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">From the blog</h2>
          <a href="/blog" class="text-sm font-semibold text-terracotta hover:text-terracotta-dark">
            View all &rarr;
          </a>
        </div>
        <a href={`/blog/${latestPost.id}`} class="mt-8 block rounded-2xl border border-sand bg-cream p-8 transition-shadow hover:shadow-md">
          <time datetime={latestPost.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wide text-terracotta">
            {latestPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <h3 class="mt-2 font-display text-2xl font-semibold text-ink">{latestPost.data.title}</h3>
          <p class="mt-3 text-ink-soft leading-relaxed">{latestPost.data.description}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-ink">Read the post &rarr;</span>
        </a>
      </div>
    </section>
  )}
</BaseLayout>
