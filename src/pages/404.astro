---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-xl flex-col items-center px-6 py-32 text-center">
    <span class="text-5xl" aria-hidden="true">🧸</span>
    <h1 class="mt-6 font-display text-3xl font-semibold text-ink">Looks like this toy got lost.</h1>
    <p class="mt-3 text-ink-soft">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-terracotta px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-terracotta-dark"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
