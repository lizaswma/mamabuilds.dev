---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Notes from a product manager learning to build apps with AI."
>
  <section class="mx-auto max-w-3xl px-6 pb-8 pt-16">
    <p class="font-semibold uppercase tracking-[0.25em] text-terracotta text-sm">Blog</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink">Notes from the building process</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">
      The prompts that worked, the ones that didn't, and everything I'm learning about building
      with AI as a product manager and as a mom with very limited free time.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20">
    {posts.length > 0 ? (
      posts.map((post) => <PostCard post={post} />)
    ) : (
      <p class="text-ink-soft">First post coming soon!</p>
    )}
  </section>
</BaseLayout>
