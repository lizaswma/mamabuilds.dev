---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinCTA from '../../components/JoinCTA.astro';
import BetaAccess from '../../components/BetaAccess.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, status, accessLabel, accessUrl, icon, iconImage, favicon, category, androidEarlyAccess, betaTestFlightUrl, betaAndroidGroupUrl, betaAndroidOptInUrl } = project.data;
const { Content } = await render(project);

// When a project has beta links we show the dedicated "Join the beta" block
// (with per-platform steps) instead of the generic top access button.
const hasBeta = Boolean(betaTestFlightUrl || betaAndroidGroupUrl);
---

<BaseLayout title={title} description={summary} favicon={favicon}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a href="/projects" class="text-sm font-semibold text-ink-soft hover:text-terracotta">&larr; All projects</a>

    <div class="mt-6 flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-terracotta">{category}</p>
        <h1 class="mt-2 font-display text-4xl font-semibold text-ink">{title}</h1>
      </div>
      {iconImage ? (
        <img src={iconImage} alt="" class="h-16 w-16 rounded-2xl border border-sand object-cover shadow-sm" />
      ) : (
        <span class="text-4xl" aria-hidden="true">{icon}</span>
      )}
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-sage-light px-3 py-1 text-xs font-semibold uppercase tracking-wide text-sage">
        {status}
      </span>
      {!hasBeta && accessUrl && accessLabel && (
        <a
          href={accessUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-terracotta px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-terracotta-dark"
        >
          {accessLabel} &rarr;
        </a>
      )}
    </div>

    <div class="prose prose-headings:font-display prose-headings:text-ink prose-p:text-ink-soft prose-a:text-terracotta mt-10 max-w-none">
      <Content />
    </div>

    {hasBeta && (
      <BetaAccess
        appName={title}
        testFlightUrl={betaTestFlightUrl}
        androidGroupUrl={betaAndroidGroupUrl}
        androidOptInUrl={betaAndroidOptInUrl}
      />
    )}

    {!hasBeta && androidEarlyAccess && <JoinCTA />}
  </article>
</BaseLayout>
