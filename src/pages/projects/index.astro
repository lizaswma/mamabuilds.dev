---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);

// Controls the order categories appear in on this page. Add a category here
// to pin its position — anything not listed falls back to alphabetical order
// after the pinned ones, so a brand-new category still shows up automatically
// without needing an edit here.
const CATEGORY_ORDER = ['Family & Kids', 'Product Management'];

const categories = [...new Set(allProjects.map((p) => p.data.category))].sort((a, b) => {
  const indexA = CATEGORY_ORDER.indexOf(a);
  const indexB = CATEGORY_ORDER.indexOf(b);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.localeCompare(b);
});

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const grouped = categories.map((category) => ({
  category,
  slug: slugify(category),
  items: allProjects
    .filter((p) => p.data.category === category)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
}));
---

<BaseLayout
  title="Projects"
  description="Small apps I've built with AI - for fellow product managers, and for my family."
>
  <section class="mx-auto max-w-5xl px-6 pb-8 pt-16">
    <p class="font-semibold uppercase tracking-[0.25em] text-terracotta text-sm">Projects</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink">Things I've built</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Every project here started as "wouldn't it be nice if..." - then got built with a lot of
      AI help, some trial and error, and whatever time I had between meetings and bedtime.
      New projects get added regularly, so check back.
    </p>
  </section>

  {grouped.length > 1 && (
    <nav
      id="category-nav"
      aria-label="Jump to category"
      class="sticky top-0 z-10 border-y border-sand/80 bg-cream/95 backdrop-blur"
    >
      <div class="mx-auto flex max-w-5xl gap-2 overflow-x-auto px-6 py-3">
        {grouped.map(({ category, slug, items }) => (
          <a
            href={`#${slug}`}
            data-category-link={slug}
            class="flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:bg-sand/70 sm:text-sm"
          >
            {category}
            <span class="rounded-full bg-sand/80 px-1.5 py-0.5 text-[0.7em] font-semibold text-ink-soft">
              {items.length}
            </span>
          </a>
        ))}
      </div>
    </nav>
  )}

  {grouped.map(({ category, slug, items }) => (
    <section id={slug} class="mx-auto max-w-5xl scroll-mt-16 px-6 py-10">
      <h2 class="font-display text-2xl font-semibold text-ink">{category}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {items.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  ))}

  {grouped.length > 1 && (
    <script>
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-category-link]');
      const sections = Array.from(links)
        .map((link) => document.getElementById(link.dataset.categoryLink!))
        .filter((el): el is HTMLElement => el !== null);

      const setActive = (slug: string | null) => {
        links.forEach((link) => {
          const isActive = link.dataset.categoryLink === slug;
          link.classList.toggle('bg-terracotta', isActive);
          link.classList.toggle('text-cream', isActive);
          link.classList.toggle('text-ink-soft', !isActive);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) setActive(visible[0].target.id);
        },
        { rootMargin: '-120px 0px -70% 0px' }
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  )}

  {allProjects.length === 0 && (
    <section class="mx-auto max-w-5xl px-6 py-10 text-ink-soft">
      New projects are on the way - check back soon!
    </section>
  )}
</BaseLayout>
