---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Per-page browser tab icon override, e.g. "/images/my-project/favicon.png".
  // Defaults to the site-wide favicon.
  favicon?: string;
  // Social preview image (og:image), a path on this site. Defaults to the
  // site-wide card; blog posts and projects pass their own generated card
  // from src/pages/og/[...slug].png.ts.
  image?: string;
}

const {
  title,
  description = "MamaBuilds - a product manager mom building small, useful apps with AI, one nap time at a time.",
  favicon = '/favicon.svg',
  image = '/og/default.png',
} = Astro.props;
const imageUrl = new URL(image, Astro.site);

const pageTitle = title === 'MamaBuilds' ? title : `${title} · MamaBuilds`;
const faviconType = favicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={faviconType} href={favicon} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / social preview -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>

    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "8dcff04c676e4bb5a08262ef59cecd6d"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
