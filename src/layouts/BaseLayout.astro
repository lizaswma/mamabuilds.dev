---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Per-page browser tab icon override, e.g. "/images/my-project/favicon.png".
  // Defaults to the site-wide favicon.
  favicon?: string;
}

const {
  title,
  description = "MamaBuilds - a product manager mom building small, useful apps with AI, one nap time at a time.",
  favicon = '/favicon.svg',
} = Astro.props;

const pageTitle = title === 'MamaBuilds' ? title : `${title} · MamaBuilds`;
const faviconType = favicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={faviconType} href={favicon} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / social preview -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
